        <item>
            <title>Version 1.0.1 (build 893)</title>
            <pubDate>Sat, 21 Nov 2026 06:57:02 +0000</pubDate>
            <sparkle:version>893</sparkle:version>
            <sparkle:shortVersionString>1.0.1</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
            <description>&lt;p&gt;MeerKatta optimized the detection for non-speech audio input, so background sounds are less likely to turn into stray text.&lt;br/&gt;Use “Teach correction” after editing a Capture or Library item to preview and save a preferred spelling.&lt;br/&gt;Fix Home page fault alarm bug.&lt;br/&gt;Fix count words in accuracy in Chinese and Japanese.&lt;br/&gt;BYOK: improved local transcriber setup.&lt;br/&gt;When polishing is unavailable, MeerKatta keeps your transcript and shows how to recover.&lt;/p&gt;</description>
            <enclosure url="https://github.com/curiowls/meerkattasparkle/releases/download/v1.0.1-b893/MeerKatta-1.0.1-b893.dmg" length="20236921" type="application/octet-stream" sparkle:edSignature="d9/xlnMD7mNpbPmrPSxjiKQyBnWpED9/2Qyvm4kqcTguvpzeX04+e540QIrV+W5z9hScYTw8FLhSIJoFTJgQAQ==" />
        </item>
        <item>
            <title>Version 1.0.0 (build 888)</title>
            <pubDate>Mon, 16 Nov 2026 03:18:19 GMT</pubDate>
            <sparkle:version>888</sparkle:version>
            <sparkle:shortVersionString>1.0.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
            <description>&lt;p&gt;• Capture recordings are saved to Library as soon as recording finishes.&lt;br/&gt;• Pin a Capture window to keep building on a thought.&lt;br/&gt;• If transcription is incomplete or needs review, your recording stays in Library so you can listen again or retry.&lt;br/&gt;• Click a word in Custom Vocabulary to fine-tune how MeerKatta recognizes it.&lt;br/&gt;• Clearer English formatting keeps natural prose intact and uses numbered lists where they make sense.&lt;/p&gt;</description>
            <enclosure url="https://github.com/curiowls/meerkattasparkle/releases/download/v1.0.0-b888/MeerKatta-1.0.0-b888.dmg" length="17781448" type="application/octet-stream" sparkle:edSignature="tZyJiwkm6cKbGBRQQ13d0ektGE6xBzQlyGMRoJH/3D8KVS7CcYgCugm/SwneDYEF+WdqD8UuNWUaHtmg3XZFCg==" />
        </item>
        <item>
            <title>Version 0.1.1 (build 879)</title>
            <pubDate>Fri, 06 Nov 2026 21:10:35 +0000</pubDate>
            <sparkle:version>879</sparkle:version>
            <sparkle:shortVersionString>0.1.1</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
            <description>&lt;p&gt;Organize your Library with optional labels, open entries to review and edit their text, and see where you used them. Select notes to merge them while keeping the originals. Library controls now fit smaller windows.&lt;br/&gt;&lt;br/&gt;Choose transcription and polishing providers independently in the reorganized Providers &amp;amp; Keys page. CLI setup shows clearer access information and troubleshooting guidance, and Account &amp;amp; Plan groups your access and license details more clearly.&lt;br/&gt;&lt;br/&gt;Fixes duplicate text insertion and unwanted switches to Dot when dictating into Codex. Fn dictation no longer reacts to arrow keys, and silent captures show “No speech detected”.&lt;br/&gt;&lt;br/&gt;If focus changes before insertion, your text stays available on the clipboard. Library save failures retain a path to retry, and Home separates older device-only statistics from synced activity.&lt;/p&gt;</description>
            <enclosure url="https://github.com/curiowls/meerkattasparkle/releases/download/v0.1.1-b879/MeerKatta-0.1.1-b879.dmg" length="16487786" type="application/octet-stream" sparkle:edSignature="8LzO4ASlXIziwuOZn5QNB7EETGh21LVXezj8UDkRswCCJvbkbDEWXl4UAk/NPlOxGm6oEp9iletUHPNtL2iBCA==" />
        </item>

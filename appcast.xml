            <title>Version 1.0.1 (build 895)</title>
            <pubDate>Mon, 23 Nov 2026 03:40:00 +0000</pubDate>
            <sparkle:version>895</sparkle:version>
            <sparkle:shortVersionString>1.0.1</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
            <description>&lt;p&gt;Fixed an issue where dictation using on-device Whisper could appear in Traditional Chinese with Simplified Chinese selected.&lt;/p&gt;</description>
